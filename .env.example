# ============================================================
# RQA2025 环境变量配置模板
# PostgreSQL 数据库持久化配置
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. 确保 .env 文件不被提交到版本控制
# ============================================================

# ============================================================
# PostgreSQL 数据库配置
# ============================================================

# 数据库主机地址
POSTGRES_HOST=localhost

# 数据库端口
POSTGRES_PORT=5432

# 数据库名称
POSTGRES_DB=rqa2025_prod

# 数据库用户名
POSTGRES_USER=rqa2025_admin

# 数据库密码（请修改为安全密码）
POSTGRES_PASSWORD=SecurePass123!

# 数据库连接池大小
POSTGRES_POOL_SIZE=10

# 数据库最大溢出连接数
POSTGRES_MAX_OVERFLOW=20

# 数据库连接超时（秒）
POSTGRES_CONNECT_TIMEOUT=30

# ============================================================
# 数据持久化策略配置
# ============================================================

# 持久化策略：postgresql_first / filesystem_only
PERSISTENCE_STRATEGY=postgresql_first

# 是否启用自动降级（PostgreSQL不可用时降级到文件系统）
PERSISTENCE_AUTO_FALLBACK=true

# 数据同步间隔（秒）
PERSISTENCE_SYNC_INTERVAL=60

# 是否启用数据压缩
PERSISTENCE_COMPRESS_DATA=true

# ============================================================
# 特征层持久化配置
# ============================================================

# 特征数据存储目录（降级时使用）
FEATURE_STORAGE_DIR=data/features

# 特征缓存最大大小
FEATURE_CACHE_SIZE=10000

# 特征数据保留天数
FEATURE_RETENTION_DAYS=365

# ============================================================
# 模型层持久化配置
# ============================================================

# 模型存储目录
MODEL_STORAGE_DIR=data/models

# 模型缓存大小
MODEL_CACHE_SIZE=100

# 推理缓存大小
INFERENCE_CACHE_SIZE=1000

# 模型版本保留数量
MODEL_VERSION_RETENTION=10

# ============================================================
# 策略层持久化配置
# ============================================================

# 策略数据存储目录
STRATEGY_STORAGE_DIR=data/strategy

# 回测结果保留数量
BACKTEST_RESULT_RETENTION=100

# 策略缓存大小
STRATEGY_CACHE_SIZE=50

# ============================================================
# 交易层持久化配置
# ============================================================

# 交易数据存储目录
TRADING_STORAGE_DIR=data/trading

# 订单缓存大小
ORDER_CACHE_SIZE=10000

# 账户缓存大小
ACCOUNT_CACHE_SIZE=1000

# 持仓缓存大小
POSITION_CACHE_SIZE=5000

# 交易记录缓存大小
TRADE_CACHE_SIZE=10000

# ============================================================
# 风险控制层持久化配置
# ============================================================

# 风险数据存储目录
RISK_STORAGE_DIR=data/risk

# 风险检查缓存大小
RISK_CHECK_CACHE_SIZE=10000

# 告警缓存大小
ALERT_CACHE_SIZE=5000

# 风险指标缓存大小
RISK_METRIC_CACHE_SIZE=10000

# 风险规则缓存大小
RISK_RULE_CACHE_SIZE=1000

# 告警自动清理天数
ALERT_AUTO_CLEANUP_DAYS=30

# ============================================================
# 日志配置
# ============================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/rqa2025.log

# 日志文件最大大小（MB）
LOG_MAX_SIZE=100

# 日志文件保留数量
LOG_BACKUP_COUNT=10

# ============================================================
# 性能配置
# ============================================================

# 数据库操作重试次数
DB_RETRY_ATTEMPTS=3

# 数据库操作重试间隔（秒）
DB_RETRY_DELAY=1.0

# 批量写入大小
BATCH_WRITE_SIZE=100

# 异步写入队列大小
ASYNC_QUEUE_SIZE=1000

# ============================================================
# 安全配置
# ============================================================

# 是否启用SSL连接
DB_SSL_ENABLED=false

# SSL证书路径
DB_SSL_CERT=

# SSL密钥路径
DB_SSL_KEY=

# SSL CA证书路径
DB_SSL_CA=

# ============================================================
# 监控配置
# ============================================================

# 是否启用持久化监控
PERSISTENCE_MONITORING_ENABLED=true

# 监控指标上报间隔（秒）
METRICS_REPORT_INTERVAL=60

# 是否启用健康检查
HEALTH_CHECK_ENABLED=true

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30
